<?xml version="1.0" encoding="UTF-8"?>

<!--
  ============================================================
  Zava Social - Web Application Deployment Descriptor
  ============================================================
  
  This is the central configuration file for the Zava Social
  web application. ALL servlet mappings are declared here by
  hand - we are using Servlet 2.4 (pre-annotations era).
  
  Do NOT add @WebServlet annotations to the servlet classes.
  This file IS the configuration. If a servlet isn't mapped
  here, it doesn't exist as far as Tomcat is concerned.
  
  Last updated: 2007-06-15
  Updated by: JK
  
  Change log:
    2007-04-15  JK  Initial creation with FeedServlet and LoginServlet
    2007-05-01  TM  Added ShoePostServlet and ReviewServlet
    2007-06-15  JK  Added ProfileServlet, bumped session timeout to 30min
    
  TODO: Add error-page mappings for 404 and 500. Right now
  users see the Tomcat default error page which looks terrible.
  TM says he'll do it "next sprint" (he's been saying that
  since May). - JK 2007-08-20
  ============================================================
-->

<!DOCTYPE web-app
    PUBLIC "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
    "http://java.sun.com/dtd/web-app_2_3.dtd">

<web-app>

    <!-- ============================================================ -->
    <!-- Display Name                                                  -->
    <!-- Shows up in Tomcat Manager and JBoss admin console            -->
    <!-- ============================================================ -->
    <display-name>Zava Social</display-name>

    <!-- ============================================================ -->
    <!-- Application Description                                       -->
    <!-- ============================================================ -->
    <description>
        Zava Social - A community platform for sneaker enthusiasts.
        Share your kicks, review shoes, and connect with other collectors.
        Built with JSP/Servlets, backed by a .NET ASMX web service via SOAP.
    </description>

    <!-- ============================================================ -->
    <!-- Context Parameters                                            -->
    <!-- These are application-wide configuration values accessible    -->
    <!-- via ServletContext.getInitParameter()                          -->
    <!-- ============================================================ -->
    
    <!--
      The URL of the backend SOAP service. Change this when deploying
      to different environments. Yes, we know this should probably be
      in a properties file or JNDI. But it works here and nobody
      wants to set up JNDI on every developer's Tomcat instance.
    -->
    <context-param>
        <param-name>soapServiceUrl</param-name>
        <param-value>http://localhost:8081/ZavaService.asmx</param-value>
    </context-param>

    <!-- 
      Number of posts to show per page on the feed.
      Hardcoded here because we don't have a real config system.
    -->
    <context-param>
        <param-name>postsPerPage</param-name>
        <param-value>10</param-value>
    </context-param>

    <!-- ============================================================ -->
    <!-- Servlet Declarations                                          -->
    <!--                                                               -->
    <!-- Each servlet must be declared here with its full class name.   -->
    <!-- No auto-scanning, no annotations - this is Servlet 2.4.      -->
    <!-- The servlet-name is used to map to URL patterns below.         -->
    <!-- ============================================================ -->

    <!--
      FeedServlet - The main landing page servlet.
      Calls GetTrendingPosts on the SOAP service and forwards
      the results to the feed JSP for rendering.
      This is the most-hit servlet in the application.
    -->
    <servlet>
        <servlet-name>FeedServlet</servlet-name>
        <servlet-class>com.zava.servlets.FeedServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!--
      ShoePostServlet - Handles viewing and creating shoe posts.
      GET: displays the shoe post form or a single post detail
      POST: submits a new shoe post to the backend via SOAP
      
      NOTE: This servlet handles both the "new post" form AND the
      "view post detail" page. The URL pattern /post is used for both.
      The postId parameter in the query string determines which mode.
      Yes, this should probably be two separate servlets. No, we're
      not refactoring it now.
    -->
    <servlet>
        <servlet-name>ShoePostServlet</servlet-name>
        <servlet-class>com.zava.servlets.ShoePostServlet</servlet-class>
    </servlet>

    <!--
      ReviewServlet - Handles shoe reviews.
      GET: displays reviews for a given shoe post
      POST: submits a new review
      
      Requires shoeId parameter - if missing, redirects to feed.
    -->
    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>com.zava.servlets.ReviewServlet</servlet-class>
    </servlet>

    <!--
      ProfileServlet - Displays user profile pages.
      GET only - profiles are read-only (the edit feature was
      planned for "Phase 2" which never happened).
      
      Takes userName parameter. If no userName, shows the
      logged-in user's profile. If not logged in and no userName,
      redirects to login.
    -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.zava.servlets.ProfileServlet</servlet-class>
    </servlet>

    <!--
      LoginServlet - Handles user authentication.
      GET: shows the login form
      POST: validates credentials against the backend
      
      On successful login, sets session attributes:
        - isLoggedIn (Boolean.TRUE)
        - currentUser (String username)
        - userProfile (UserProfile bean)
      
      On failure, forwards back to login form with error message.
      
      NOTE: There is no LogoutServlet. Logout is handled by
      LoginServlet with a ?action=logout query parameter.
      This is because TM didn't want to create a whole new
      servlet class just to call session.invalidate().
    -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.zava.servlets.LoginServlet</servlet-class>
    </servlet>

    <!-- ============================================================ -->
    <!-- Servlet Mappings                                              -->
    <!--                                                               -->
    <!-- Maps URL patterns to the servlets declared above.             -->
    <!-- These are clean URLs - no .do suffix, no /servlet/ prefix.   -->
    <!-- We considered using /servlet/ auto-mapping but decided        -->
    <!-- explicit mappings are more maintainable. (Ha.)                -->
    <!-- ============================================================ -->

    <!--
      Feed servlet is the main page - mapped to /feed
      Also the target of the welcome-file redirect
    -->
    <servlet-mapping>
        <servlet-name>FeedServlet</servlet-name>
        <url-pattern>/feed</url-pattern>
    </servlet-mapping>

    <!--
      Shoe post servlet - mapped to /post
      /post (no params) = show new post form
      /post?postId=123  = show post detail
    -->
    <servlet-mapping>
        <servlet-name>ShoePostServlet</servlet-name>
        <url-pattern>/post</url-pattern>
    </servlet-mapping>

    <!--
      Reviews servlet - mapped to /reviews
      /reviews?shoeId=123 = show reviews for a shoe
    -->
    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/reviews</url-pattern>
    </servlet-mapping>

    <!--
      Profile servlet - mapped to /profile
      /profile?userName=kickz_fan99 = show user's profile
      /profile (no params) = show logged-in user's profile
    -->
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <!--
      Login servlet - mapped to /login
      /login = show login form
      /login?action=logout = log out and redirect to feed
    -->
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- ============================================================ -->
    <!-- Session Configuration                                         -->
    <!--                                                               -->
    <!-- 30 minute timeout. Originally was 15 but users complained     -->
    <!-- they kept getting logged out while writing long reviews.       -->
    <!-- Bumped to 30 in June 2007.                                    -->
    <!-- ============================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ============================================================ -->
    <!-- Welcome File List                                             -->
    <!--                                                               -->
    <!-- When users hit the root URL, serve index.jsp which            -->
    <!-- forwards to the feed servlet.                                 -->
    <!-- ============================================================ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================ -->
    <!-- Error Pages                                                   -->
    <!--                                                               -->
    <!-- TODO: Create custom error pages!!                             -->
    <!-- Right now users see the raw Tomcat error page with stack      -->
    <!-- traces. This is a KNOWN ISSUE. TM has a ticket for it.        -->
    <!-- Somewhere. Probably.                                          -->
    <!--                                                               -->
    <!-- Uncomment these once the error JSPs are created:              -->
    <!--                                                               -->
    <!-- <error-page>                                                  -->
    <!--     <error-code>404</error-code>                              -->
    <!--     <location>/WEB-INF/jsp/error404.jsp</location>            -->
    <!-- </error-page>                                                 -->
    <!--                                                               -->
    <!-- <error-page>                                                  -->
    <!--     <error-code>500</error-code>                              -->
    <!--     <location>/WEB-INF/jsp/error500.jsp</location>            -->
    <!-- </error-page>                                                 -->
    <!--                                                               -->
    <!-- <error-page>                                                  -->
    <!--     <exception-type>java.lang.Exception</exception-type>      -->
    <!--     <location>/WEB-INF/jsp/error500.jsp</location>            -->
    <!-- </error-page>                                                 -->
    <!-- ============================================================ -->

    <!-- ============================================================ -->
    <!-- MIME Mappings                                                  -->
    <!-- Probably not needed since Tomcat handles most of these, but   -->
    <!-- we had issues with CSS not loading on one developer's machine -->
    <!-- so we added these explicitly. Better safe than sorry.         -->
    <!-- ============================================================ -->
    <mime-mapping>
        <extension>css</extension>
        <mime-type>text/css</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>js</extension>
        <mime-type>application/javascript</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>jpg</extension>
        <mime-type>image/jpeg</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>gif</extension>
        <mime-type>image/gif</mime-type>
    </mime-mapping>
    <mime-mapping>
        <extension>png</extension>
        <mime-type>image/png</mime-type>
    </mime-mapping>

</web-app>
